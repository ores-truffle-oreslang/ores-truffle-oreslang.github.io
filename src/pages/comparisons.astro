---
import BaseLayout from "../layouts/BaseLayout.astro";
import { comparisons } from "../data/comparisons.mjs";
import "../styles/comparisons.css";
---

<BaseLayout
  title="Why Oreslang? Deep comparisons with Rust, Go, Erlang and more"
  description="Why Oreslang combines ownership, lightweight Tasks, supervised actors, native compilation and hot code replacement. Detailed tradeoffs versus ten languages."
>
  <section class="page-hero comparisons-hero">
    <p class="kicker">Comparisons / language design</p>
    <h1>Own your memory. Supervise your failures. Keep your code running.</h1>
    <p><strong>Oreslang = ~(Erlang + Rust).</strong> The ambition: the static safety of ownership, the resilience of actors and the freedom of native compilation, without assembling separate runtimes for every part of your system.</p>
    <div class="comparison-value-bar" aria-label="Oreslang's core design advantages">
      <span>Typed ownership</span>
      <span>Tasks + actors</span>
      <span>Supervision + hot reload</span>
      <span>LLVM + GraalVM directions</span>
    </div>
    <p><a href="/erlang-rust-oreslang/">Explore the 24-feature comparison table: Erlang · Rust · Oreslang · other languages →</a></p>
    <p class="comparison-disclaimer">
      <strong>Architecture goals, not unverified promises.</strong> This is a comparison of intended designs, not a claim that Oreslang has shipped every feature or wins every benchmark.
      The <a href="/language/">public feature matrix</a> currently marks backend support as unverified.
    </p>
  </section>

  <section class="page-body comparisons-body" aria-label="Language comparisons">
    <div class="comparison-toolbar">
      <div>
        <label for="language-picker">Compare Oreslang with</label>
        <p>Ten ecosystems. Five deep technical contrasts each. A clear case for when Oreslang matters.</p>
      </div>
      <select id="language-picker" name="language" aria-controls="comparison-content">
        {comparisons.map((comparison) => (
          <option value={comparison.id}>{comparison.name}</option>
        ))}
      </select>
    </div>

    <div id="comparison-content" class="comparison-content">
      {comparisons.map((comparison, index) => (
        <article
          class="comparison-panel"
          data-comparison={comparison.id}
          id={`compare-${comparison.id}`}
          aria-labelledby={`compare-title-${comparison.id}`}
          hidden={index !== 0}
        >
          <div class="comparison-intro">
            <p class="eyebrow">Oreslang / {comparison.name}</p>
            <h2 id={`compare-title-${comparison.id}`}>Oreslang vs. {comparison.name}</h2>
            <p class="comparison-headline">{comparison.headline}</p>
          </div>

          <div class="comparison-thesis">
            <p class="eyebrow">The Oreslang case</p>
            <p>{comparison.thesis}</p>
          </div>

          <div class="comparison-benefits" aria-label={`Three reasons to choose Oreslang's direction over ${comparison.name}`}>
            {comparison.benefits.map((benefit, index) => (
              <section class="comparison-benefit">
                <span class="comparison-benefit-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <h3>{benefit.title}</h3>
                <p>{benefit.detail}</p>
              </section>
            ))}
          </div>

          <div class="comparison-strength">
            <h3>Respect what {comparison.name} already does well</h3>
            <p>{comparison.strength}</p>
          </div>

          <h3 class="comparison-section-title">Where the architectures differ</h3>
          <p class="comparison-section-subtitle">Not feature-name checkboxes: what changes for people building and operating systems.</p>
          <div class="comparison-angles" aria-label={`Tradeoffs versus ${comparison.name}`}>
            {comparison.angles.map((angle) => (
              <section class="comparison-angle">
                <h3>{angle.topic}</h3>
                <div class="comparison-columns">
                  <div>
                    <h4>{comparison.name} today</h4>
                    <p>{angle.peer}</p>
                  </div>
                  <div>
                    <h4>Oreslang direction</h4>
                    <p>{angle.oreslang}</p>
                  </div>
                </div>
                <div class="comparison-impact">
                  <strong>Why it matters</strong>
                  <p>{angle.impact}</p>
                </div>
              </section>
            ))}
          </div>

          <section class="comparison-use-cases">
            <h3 class="comparison-section-title">Where Oreslang's direction is especially compelling</h3>
            <div class="comparison-use-grid">
              {comparison.useCases.map((useCase) => (
                <div class="comparison-use-card">
                  <h4>{useCase.title}</h4>
                  <p>{useCase.detail}</p>
                </div>
              ))}
            </div>
          </section>

          <div class="comparison-boundary">
            <h3>What is ready today—and what still needs proof</h3>
            <p>{comparison.boundary}</p>
          </div>

          <div class="comparison-references">
            <h3>Further reading</h3>
            <ul>
              {comparison.sources.map((source) => (
                <li><a href={source.url} rel="noopener noreferrer" target="_blank">{source.label} ↗</a></li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
    <p class="comparison-footnote">
      For measured results and their limitations, see <a href="/performance/">Performance</a>.
      For compiler-verification status, see <a href="/language/">Language reference</a>.
    </p>
    <p class="comparison-announcement" id="comparison-announcement" role="status" aria-live="polite" aria-atomic="true"></p>
  </section>
</BaseLayout>

<script>
  const picker = document.querySelector<HTMLSelectElement>("#language-picker");
  const content = document.querySelector<HTMLElement>("#comparison-content");
  const announcement = document.querySelector<HTMLElement>("#comparison-announcement");
  if (picker && content) {
    const panels = Array.from(content.querySelectorAll<HTMLElement>("[data-comparison]"));
    const allowed = new Set(Array.from(picker.options, (option) => option.value));
    const defaultLanguage = picker.options[0]?.value ?? "elixir";

    const show = (requested: string, updateHistory = false) => {
      const language = allowed.has(requested) ? requested : defaultLanguage;
      for (const panel of panels) {
        panel.hidden = panel.dataset.comparison !== language;
      }
      picker.value = language;
      if (updateHistory) {
        const url = new URL(window.location.href);
        url.searchParams.set("language", language);
        window.history.pushState({ language }, "", url);
      }
      if (announcement) {
        const name = picker.selectedOptions[0]?.textContent ?? language;
        announcement.textContent = `Showing Oreslang compared with ${name}.`;
      }
    };

    const fromUrl = () => {
      const params = new URL(window.location.href).searchParams;
      show(params.get("language") ?? defaultLanguage);
    };

    picker.addEventListener("change", () => show(picker.value, true));
    window.addEventListener("popstate", fromUrl);
    fromUrl();
  }
</script>
