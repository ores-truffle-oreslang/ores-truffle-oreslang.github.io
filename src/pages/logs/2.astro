        <li><a href="#package-policy">Package policy</a></li>
        <li><a href="#actor-portability">Actors and async portability</a></li>
        <li><a href="#implementation-status">Implementation status</a></li>
      </ol>
    </aside>
    <article class="log-article prose" aria-label="Engineering log #2"><Log2Content /></article>
  </div>
  <nav class="log-entry-footer" aria-label="Article navigation"><a href="/logs/1/">← Log 001</a><a href="/logs/">All engineering logs →</a></nav>
</BaseLayout>
