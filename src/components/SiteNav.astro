---
const { home = false } = Astro.props;

const hrefFor = (anchor: string) => home ? `#${anchor}` : `/#${anchor}`;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Oreslang home">oreslang</a>
  <nav aria-label="Primary navigation">
    <a href={hrefFor("about")}>about</a>
    <a href={hrefFor("philosophy")}>philosophy</a>
    <a href={hrefFor("examples")}>examples</a>
    <a href={hrefFor("problem-spaces")}>problem spaces</a>
    <a href={hrefFor("links")}>links</a>
  </nav>
</header>
